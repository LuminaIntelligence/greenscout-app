# ---------------------------------------------------------------------------
# GreenScout — .gitignore
# Covers Next.js + Node + Python + Docker + Prisma + macOS/Windows/Linux IDEs
# ---------------------------------------------------------------------------

# ----- Node / Next.js --------------------------------------------------------
node_modules/
.pnp.*
.yarn/
.npm/
.eslintcache
.stylelintcache

.next/
out/
build/
dist/
coverage/
.coverage/
playwright-report/
test-results/
.playwright/

next-env.d.ts
.tsbuildinfo
*.tsbuildinfo

# ----- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Environment & secrets -------------------------------------------------
# Never commit real env files. Only *.example variants are allowed in git.
.env
.env.*
!.env.example
!.env.production.example
.envrc
.secrets/
*.pem
*.key
*.crt
secrets.json
serviceAccountKey.json

# ----- Prisma ----------------------------------------------------------------
# Generated client + local dev DB
src/generated/
prisma/dev.db
prisma/dev.db-journal
prisma/*.sqlite
prisma/*.sqlite-journal
prisma/migrations/*/migration.sql.bak
# esbuild-bundle des seed-Skripts wird im Docker-builder erzeugt
# (siehe Dockerfile.web + DECISIONS.md "Seed via esbuild-Bundle").
prisma/seed.cjs

# ----- Uploads & generated artefacts ----------------------------------------
# Match only repo-root `./uploads/` so we don't accidentally hide the
# Next.js route at `src/app/api/uploads/` (Slice 4 added that route).
/uploads/
/test-uploads/
/generated/
tmp/
temp/
*.pptx.bak
*.pdf.bak

# ----- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
*.egg-info/
pip-wheel-metadata/

# ----- Docker ----------------------------------------------------------------
# Local docker-compose overrides, never commit local ones.
docker-compose.override.yml
.docker/

# ----- IDEs & editors --------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
*.swp
*.swo
*~

# ----- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- Claude Code session artefacts ----------------------------------------
# Keep the agent definitions and settings.json, but ignore session-local state.
.claude/sessions/
.claude/cache/
.claude/*.log

# ----- Misc ------------------------------------------------------------------
.history/
.cache/
*.tgz
*.zip
*.7z
