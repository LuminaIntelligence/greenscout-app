# =============================================================================
# GreenScout — .env.example
# Copy this file to .env (never commit the real .env) and fill in the values.
# Production values live on the Hetzner VPS only; staging in CI secrets.
#
# Format: KEY="value"   (quote everything to avoid YAML-style interpretation)
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
APP_PORT="3000"
TZ="Europe/Berlin"


# -----------------------------------------------------------------------------
# PostgreSQL (used by Prisma)
# -----------------------------------------------------------------------------
POSTGRES_USER="greenscout"
POSTGRES_PASSWORD="REPLACE_ME_LOCALLY_ONLY"
POSTGRES_DB="greenscout_dev"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://greenscout:REPLACE_ME_LOCALLY_ONLY@localhost:5432/greenscout_dev?schema=public"


# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# -----------------------------------------------------------------------------
# Generate with:   openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_32_BYTE_BASE64"
AUTH_TRUST_HOST="true"

# Session lifetime in seconds (8h per SPEC.md §4.1)
AUTH_SESSION_MAX_AGE_SECONDS="28800"

# Argon2 cost factors (SPEC.md §6.3). Bump in production if hardware allows.
PASSWORD_HASH_MEMORY_KIB="19456"
PASSWORD_HASH_TIME_COST="2"
PASSWORD_HASH_PARALLELISM="1"


# -----------------------------------------------------------------------------
# Lockout policy (SPEC.md §4.1)
# -----------------------------------------------------------------------------
LOCKOUT_FAIL_THRESHOLD_FIRST="5"
LOCKOUT_DURATION_FIRST_MINUTES="15"
LOCKOUT_FAIL_THRESHOLD_SECOND="10"
LOCKOUT_DURATION_SECOND_MINUTES="60"


# -----------------------------------------------------------------------------
# Initial admin (created by `prisma db seed` if the user table is empty)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="consulting@lumina-intelligence.ai"
SEED_ADMIN_TEMP_PASSWORD="REPLACE_AT_FIRST_LOGIN"


# -----------------------------------------------------------------------------
# Python service (PPTX + PDF generation)
# -----------------------------------------------------------------------------
PYTHON_SERVICE_URL="http://localhost:8000"
PYTHON_SERVICE_API_KEY="REPLACE_WITH_LONG_RANDOM_STRING"
PYTHON_SERVICE_TIMEOUT_SECONDS="60"


# -----------------------------------------------------------------------------
# Storage paths (mounted into both containers)
# -----------------------------------------------------------------------------
UPLOADS_DIR="./uploads"
GENERATED_DIR="./generated"
MAX_UPLOAD_MB="10"
MAX_IMAGE_DIMENSION_PX="4000"


# -----------------------------------------------------------------------------
# SMTP (configured by the admin via the in-app Settings page; values here
# are only used as bootstrap defaults the first time the app starts.)
# In MVP, used only for admin lockout-escalation alerts.
# In V2, also used for password-reset emails and outbound PDF delivery.
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="GreenScout"
SMTP_FROM_ADDRESS=""
SMTP_USE_STARTTLS="true"

# Key (base64, 32 bytes) used to encrypt SMTP credentials at rest in the DB.
# Generate with:   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64"


# -----------------------------------------------------------------------------
# Retention (SPEC.md §6.1)
# -----------------------------------------------------------------------------
RETENTION_YEARS="10"
RETENTION_NOTICE_DAYS="60,30,7"


# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
FEATURE_V2_EMAIL_PASSWORD_RESET="false"
FEATURE_V2_EMAIL_PDF_DELIVERY="false"
FEATURE_PHASE3_CUSTOMER_PORTAL="false"
FEATURE_PHASE3_PV_SOL_INTEGRATION="false"


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL="info"           # one of: debug, info, warn, error
LOG_FORMAT="pretty"        # "pretty" in dev, "json" in production


# -----------------------------------------------------------------------------
# Playwright (E2E tests)
# -----------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL="http://localhost:3000"
