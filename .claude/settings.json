{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "GreenScout — Claude Code permissions, allowed tools and auto-mode profile. Aligned with CLAUDE.md §§6,7,8. Auto-mode is Balanced: 2h or 500k tokens per autonomous run, then recap.",
  "model": "claude-opus-4-7",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(pnpm run *)",
      "Bash(yarn *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip install -r *)",
      "Bash(pip install --upgrade pip)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(pyright *)",
      "Bash(uv *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin refactor/*)",
      "Bash(git push origin docs/*)",
      "Bash(git pull --ff-only)",
      "Bash(git fetch *)",
      "Bash(git stash *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(prisma *)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma format)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma migrate dev *)",
      "Bash(npx prisma migrate status)",
      "Bash(docker compose build)",
      "Bash(docker compose build *)",
      "Bash(docker compose up -d *)",
      "Bash(docker compose down)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find . -type f *)",
      "Bash(find ./src *)",
      "Bash(find ./app *)",
      "Bash(find ./tests *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(pip install *)",
      "Bash(npm uninstall *)",
      "Bash(pnpm remove *)",
      "Bash(pip uninstall *)",
      "Bash(npx prisma migrate reset *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down -v *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(git tag *)",
      "Bash(git cherry-pick *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git revert *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf node_modules)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * main*)",
      "Bash(git push origin main*)",
      "Bash(git push origin main)",
      "Bash(git checkout main -- *)",
      "Bash(git branch -D main)",
      "Bash(git branch -d main)",
      "Bash(git branch -m main *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fdx)",
      "Bash(git clean -fd)",
      "Bash(npx prisma migrate deploy *)",
      "Bash(prisma migrate deploy *)",
      "Bash(npx prisma db push --accept-data-loss*)",
      "Bash(docker compose -f *production* *)",
      "Bash(docker compose -f *prod* *)",
      "Bash(chmod 777 *)",
      "Bash(eval *)",
      "Bash(:(){ *)",
      "Bash(mkfs *)",
      "Bash(dd if=*)"
    ]
  },
  "autoMode": {
    "_comment": "Balanced profile per CLAUDE.md §10. Soft caps; agent must self-stop and recap when reached.",
    "profile": "balanced",
    "maxRunDurationMinutes": 120,
    "maxRunTokens": 500000,
    "stagnation": {
      "maxConsecutiveTestFailures": 3,
      "maxFileRewriteAttempts": 5
    },
    "uncertaintyBehaviour": "assume-document-continue",
    "decisionLog": "DECISIONS.md",
    "hardStopOn": [
      "pause-trigger",
      "forbidden-action",
      "spec-conflict",
      "auth-change",
      "dsgvo-change",
      "pricing-change",
      "production-target"
    ]
  },
  "subagents": {
    "planner": { "definition": ".claude/agents/planner.md" },
    "implementer": { "definition": ".claude/agents/implementer.md" },
    "test-writer": { "definition": ".claude/agents/test-writer.md" },
    "reviewer": { "definition": ".claude/agents/reviewer.md" }
  }
}
