# syntax=docker/dockerfile:1.7
# GreenScout Next.js web service.
# Multi-stage build (deps → builder → runner) producing a minimal runtime image
# anchored on Next.js's standalone output (next.config.ts `output: "standalone"`).
# Base image matches the .nvmrc pin (Node 24) per DECISIONS.md.

# ----- Stage 1: install production + dev dependencies for the build -----------
FROM node:24-alpine AS deps
WORKDIR /app

# Copy only the manifests so this layer caches across source-only changes.
COPY package.json package-lock.json ./

# Optional dependencies are kept on purpose: `@node-rs/argon2` ships its
# native bindings as platform-specific optional packages
# (e.g. `@node-rs/argon2-linux-x64-musl` for alpine). Skipping optionals
# would silently drop the runtime-required binary and break
# `next build`'s page-data collection on the `[...nextauth]` route.
RUN npm ci


# ----- Stage 2: build the Next.js production bundle ---------------------------
FROM node:24-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Disable Next.js telemetry inside the image build.
ENV NEXT_TELEMETRY_DISABLED=1

# Build-only AUTH_SECRET — Auth.js v5 throws at module-load if AUTH_SECRET
# is missing/empty/placeholder, and Next 15's page-data collection
# instantiates the `[...nextauth]` route during `next build`. The value
# here is a build-time-only ephemeral; the runtime AUTH_SECRET MUST be
# injected via the runtime environment (docker run --env-file) and is
# validated again on container start by `src/lib/auth.config.ts`.
ENV AUTH_SECRET="build-time-ephemeral-do-not-use-at-runtime"

# Prisma Client is gitignored (src/generated/prisma is regenerated on every
# `db:generate`). The Next.js build imports the client via `src/lib/db.ts`,
# so we MUST generate it before `next build` or typecheck fails with
# "Cannot find module '@/generated/prisma'". See DECISIONS.md T-014.
RUN npx prisma generate

RUN npm run build

# Bundle prisma/seed.ts to a self-contained CommonJS file for the
# runner. Background: seed.ts imports TypeScript modules via `@/`
# path aliases (@/lib/db, @/features/auth/utils/hash-password, …).
# Running it at deploy-time via tsx requires tsx + its transitive
# deps (esbuild, get-tsconfig, …) in the runner, none of which sit
# in Next.js's standalone trace. A single esbuild-bundle here in
# the builder produces a stand-alone .cjs that `node` can execute
# directly — runner image stays slim, no tsx needed at runtime.
#
# Externals:
# - `@prisma/client` — the generated client (src/generated/prisma/*)
#   internally `require('@prisma/client/runtime/library')`; resolved
#   at runtime from node_modules. Sits in the runner via the
#   `node_modules/@prisma` directory-COPY (PR #28) + standalone trace.
# - `@node-rs/argon2` — native Rust bindings via NAPI, can't be
#   bundled. Sits in the runner via Next.js standalone trace
#   (imported transitively by the auth services that seed.ts pulls in
#   via `hashPassword`).
#
# esbuild is transitively present via vitest / @vitejs/plugin-react;
# `npx --no-install` mirrors the deploy.sh defensive style — if
# esbuild ever drops out of the transitive set the Docker build
# breaks loudly here, not silently at deploy-time.
RUN npx --no-install esbuild prisma/seed.ts \
    --bundle \
    --platform=node \
    --format=cjs \
    --external:@prisma/client \
    --external:@node-rs/argon2 \
    --outfile=prisma/seed.cjs


# ----- Stage 3: minimal runtime ------------------------------------------------
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Prisma's schema-engine binary (used by `prisma migrate deploy`) is
# dynamically linked against libssl/libcrypto. node:24-alpine does NOT
# ship those by default; without them the engine aborts at startup with
# "Could not parse schema engine response: Error load …" + "Prisma
# failed to detect libssl/openssl". `apk add --no-cache openssl` pulls
# in the libssl3 + libcrypto3 shared objects (and the CLI, which we
# don't strictly need but it lands together — ~1.5 MB total).
#
# We deliberately skip `ca-certificates` here: GreenScout's prod DB
# connection runs over the internal docker network without TLS
# (DATABASE_URL is `postgresql://...@db:5432/...` with no `sslmode`),
# so the trust store isn't read. If/when the deployment ever talks
# to a managed Postgres over TLS, append `ca-certificates`.
#
# Same base image as builder (node:24-alpine) → Prisma's `native`
# binaryTarget already resolves correctly to
# `linux-musl-openssl-3.0.x`; no `binaryTargets` entry needed in
# prisma/schema.prisma. Locked in via DECISIONS.md.
RUN apk add --no-cache openssl

# Run as a non-root user (CLAUDE.md §3 hardening — defence in depth).
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

# Standalone output bundles `server.js` + a pruned node_modules tree.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Bake the Prisma CLI (devDependency) into the runtime image.
# Reason: Next.js's standalone `output: "standalone"` trace only includes
# what `server.js` imports at runtime — `@prisma/client` is in (it's a
# runtime dep), but the `prisma` CLI is NOT (it's a devDependency, and
# server.js never imports it). Without the CLI present locally,
# `deploy.sh`'s `npx prisma migrate deploy` would resolve "prisma not
# installed" and silently pull `latest` off the registry, which is now
# Prisma 7 — incompatible with the 5.x schema syntax.
# `@prisma` copy is a no-op overwrite of what `server.js` already
# traced — same version from the same `npm ci` in the builder stage.
#
# NOTE: `tsx` is intentionally NOT copied. The seed entry point is the
# esbuild-bundled `prisma/seed.cjs` produced in the builder stage; the
# runner invokes it as `node prisma/seed.cjs` — no TS-loader needed.
# A dangling `.bin/tsx` symlink remains in the `.bin`-COPY below;
# harmless because nothing in the runner ever invokes it.
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/prisma ./node_modules/prisma
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/@prisma ./node_modules/@prisma
# Verzeichnis-COPY statt einzelner Datei-COPY: Dockerfile-COPY auf eine
# Datei-Quelle dereferenziert Symlinks (Inhalt wird kopiert, Pfad-Bezug
# zur ursprünglichen Datei verloren). prisma-CLI ruft sich selbst via
# diesen Bin-Symlink wieder auf und erwartet Geschwister-Dateien wie
# `prisma_schema_build_bg.wasm` relativ zum Symlink-Target zu finden.
# Verzeichnis-COPY (`/app/node_modules/.bin`) behält die Symlinks als
# Symlinks bei → `..` löst korrekt nach `node_modules/prisma/build/`
# auf. Siehe DECISIONS.md → "Hotfix: .bin-Symlinks im runner-Image".
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/.bin ./node_modules/.bin

# Schema + migrations + seed.ts needed by `prisma migrate deploy` and
# the direct `tsx prisma/seed.ts` seed invocation (see
# docs/deploy-anleitung.md §5). We deliberately do NOT overwrite the
# pruned `package.json` that Next.js's standalone build produced —
# the seed command is called directly via `tsx`, bypassing the
# `prisma.seed` config-block indirection that would otherwise need
# the source package.json.
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

USER nextjs

EXPOSE 3000

# `HOSTNAME=0.0.0.0` is required by Next.js's standalone server so it binds on
# all interfaces and is reachable from outside the container.
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "server.js"]
