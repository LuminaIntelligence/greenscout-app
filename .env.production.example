# =============================================================================
# GreenScout — .env.production.example
#
# Kopiere diese Datei auf dem Server nach `.env.production` (NICHT committen,
# steht in .gitignore via `.env.*`-Muster). Fülle alle Platzhalter aus.
#
# Wird vom docker-compose.prod.yml und vom deploy.sh konsumiert.
# =============================================================================

# Datenbank-URL für Prisma. Muss exakt der Container-DB entsprechen.
# Format: postgresql://<user>:<password>@db:5432/<db>?schema=public
# Beispiel: postgresql://greenscout:HIER_PASSWORT_EINSETZEN@db:5432/greenscout?schema=public
DATABASE_URL="postgresql://greenscout:REPLACE_ME@db:5432/greenscout?schema=public"

# Postgres-Passwort (muss zum DATABASE_URL passen).
# Generiere ein langes zufälliges Passwort:   openssl rand -base64 32
POSTGRES_PASSWORD="REPLACE_ME"

# Auth.js v5 Session-Secret (32 Byte Base64).
# Generiere mit:   openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_32_BYTE_BASE64"

# Verschlüsselungs-Key für SMTP-Credentials in der DB (32 Byte Base64).
# Generiere mit:   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64"

# Öffentliche Adresse der App — wird in Mails und Auth-Callbacks verwendet.
APP_URL="https://greenscout.lumina-intelligence.ai"

# Python-Service shared-secret auth (X-API-Key header).
# Web- und Python-Container lesen beide aus dieser env-Variable —
# beide MÜSSEN denselben Wert haben (gleiche .env.production wird
# via env_file: in docker-compose.prod.yml an beide gemountet).
# Generiere mit:   openssl rand -base64 32
PYTHON_SERVICE_API_KEY="REPLACE_WITH_LONG_RANDOM_STRING"

# §7.10-Pivot PR 3 — Internal Render Token.
# Shared-Secret-Header zwischen `generateDocumentAction` (Playwright-
# Wrapper) und der internen Render-Route `/internal/render-study/[id]`.
# Headless Chromium hat KEIN Auth-Cookie — der Token-Gate ersetzt den
# Session-Auth-Branch. Pattern analog PYTHON_SERVICE_API_KEY.
# Generiere mit:   openssl rand -base64 32
INTERNAL_RENDER_TOKEN="REPLACE_WITH_LONG_RANDOM_STRING"

# (Optional, nur beim ersten Deploy gebraucht) — Email für Let's Encrypt /
# certbot. certbot schickt an diese Adresse Ablauf-Warnungen.
CERTBOT_EMAIL=""
