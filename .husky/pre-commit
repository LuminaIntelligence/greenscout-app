#!/usr/bin/env sh

# GreenScout pre-commit gate chain (CLAUDE.md S5.1)
# Order: tsc -> lint-staged (eslint -> prettier -> ruff -> pyright per-file) -> gitleaks

set -e

echo "-> tsc --noEmit"
npx tsc --noEmit

echo "-> lint-staged"
npx lint-staged

echo "-> gitleaks git --staged"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "x gitleaks not found in PATH."
  echo "  Install via:"
  echo "    Windows: winget install gitleaks"
  echo "    macOS:   brew install gitleaks"
  echo "    Linux:   see https://github.com/gitleaks/gitleaks#installing"
  echo "  Bypassing with --no-verify is a CLAUDE.md S8.12 violation for agents."
  exit 1
fi
# gitleaks 8.30 replaced `protect --staged` with `git --staged`.
gitleaks git --staged --redact --verbose --config .gitleaks.toml

echo "ok pre-commit"
