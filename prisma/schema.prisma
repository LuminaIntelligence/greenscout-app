// GreenScout — Prisma schema
// Schema source-of-truth: DECISIONS.md → "Slice 2 schema design approved
// (user-confirmed, binding for T-009 through T-013)". Do not add models
// here without updating that entry first.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = []
  // `native` deckt den Dev-Build (Windows/macOS-DLL bzw. host-passend) ab.
  // `linux-musl-openssl-3.0.x` ist der explizite Target für das prod
  // runner-Image (node:24-alpine + apk-installed openssl 3). Ohne den
  // expliziten Eintrag generiert `prisma generate` in der builder-Stage
  // (die kein OpenSSL hat) nur den nicht-openssl `linux-musl`-Engine,
  // und der Client crasht zur Laufzeit im runner mit "query-engine
  // fehlt für linux-musl-openssl-3.0.x". Siehe DECISIONS.md →
  // "Hotfix: Prisma engine binaryTarget für musl-openssl".
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────

enum Role {
  ADMIN
  BERATER
}

enum StudyStatus {
  DRAFT
  READY
  GENERATED
}

enum ImageType {
  BEFORE
  AFTER
}

enum DocFormat {
  PPTX
  PDF
}

enum FormPref {
  WIZARD
  SINGLE_PAGE
}

// ─── Models ──────────────────────────────────────────────────────────

/// Internal consultant or admin account.
/// See DECISIONS.md "Slice 2 schema design approved" for the field contract.
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  passwordChangedAt  DateTime? @map("password_changed_at")
  role               Role      @default(BERATER)
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  phone              String?
  mobile             String?
  addressLine        String?   @map("address_line")
  signaturePhotoUrl  String?   @map("signature_photo_url")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockoutUntil       DateTime? @map("lockout_until")
  formPreference     FormPref  @default(WIZARD) @map("form_preference")
  active             Boolean   @default(true)

  // Back-relations
  consultantStudies  Study[]             @relation("ConsultantStudies")
  generatedDocuments GeneratedDocument[]
  auditLogs          AuditLog[]

  deletedAt      DateTime? @map("deleted_at")
  organizationId String    @default("greenscout") @map("organization_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, role, active, deletedAt])
  @@index([organizationId, createdAt])
}

/// External customer entity (the property owner who receives the feasibility study).
/// See DECISIONS.md "Slice 2 schema design approved" for the field contract.
model Customer {
  id               String  @id @default(cuid())
  contactFirstName String  @map("contact_first_name")
  contactLastName  String  @map("contact_last_name")
  companyName      String? @map("company_name")
  email            String?
  phone            String?
  billingAddress   String? @map("billing_address")
  billingZipCode   String? @map("billing_zip_code")
  billingCity      String? @map("billing_city")
  notes            String?

  // Back-relations
  studies Study[] @relation("CustomerStudies")

  deletedAt      DateTime? @map("deleted_at")
  organizationId String    @default("greenscout") @map("organization_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, deletedAt])
  @@index([organizationId, contactLastName])
}

/// Photovoltaic feasibility study — central business entity.
/// See DECISIONS.md "Slice 2 schema design approved" for the field contract
/// and the §7.7-relevant Decimal precision matrix.
model Study {
  id String @id @default(cuid())

  // Relations
  consultantId String   @map("consultant_id")
  consultant   User     @relation("ConsultantStudies", fields: [consultantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId   String   @map("customer_id")
  customer     Customer @relation("CustomerStudies", fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Status
  status StudyStatus @default(DRAFT)

  // Object data
  objectName    String @map("object_name")
  objectAddress String @map("object_address")
  objectZipCode String @map("object_zip_code")
  objectCity    String @map("object_city")
  flurstueck    String

  // PV inputs (§7.7 money-relevant)
  anlageKwp               Decimal @map("anlage_kwp") @db.Decimal(10, 3)
  pvErzeugungKwhJahr      Decimal @map("pv_erzeugung_kwh_jahr") @db.Decimal(12, 2)
  pvEigenverbrauchKwhJahr Decimal @map("pv_eigenverbrauch_kwh_jahr") @db.Decimal(12, 2)
  pvVerkaufEurKwh         Decimal @map("pv_verkauf_eur_kwh") @db.Decimal(8, 4)
  verbrauchKwhJahr        Decimal @map("verbrauch_kwh_jahr") @db.Decimal(12, 2)
  versorgerPreisEurKwh    Decimal @map("versorger_preis_eur_kwh") @db.Decimal(8, 4)
  pachtEurProKwp          Decimal @default(100) @map("pacht_eur_pro_kwp") @db.Decimal(8, 2)
  vertragslaufzeitJahre   Int     @default(20) @map("vertragslaufzeit_jahre")

  // Module / Anlage spec (optional from PV-Sol)
  modulAnzahl                 Int?     @map("modul_anzahl")
  modulFlaecheM2              Decimal? @map("modul_flaeche_m2") @db.Decimal(10, 2)
  eigenverbrauchsquoteProzent Decimal? @map("eigenverbrauchsquote_prozent") @db.Decimal(5, 2)
  netzeinspeisungKwhJahr      Decimal? @map("netzeinspeisung_kwh_jahr") @db.Decimal(12, 2)

  // Sensitivity scenarios (defaults 35/40/45 ct/kWh per DECISIONS Wizard-Step-5)
  szenarioPreis1 Decimal? @default("0.35") @map("szenario_preis_1") @db.Decimal(8, 4)
  szenarioPreis2 Decimal? @default("0.40") @map("szenario_preis_2") @db.Decimal(8, 4)
  szenarioPreis3 Decimal? @default("0.45") @map("szenario_preis_3") @db.Decimal(8, 4)

  // Termine for Slide 19
  terminVorschlag1 DateTime? @map("termin_vorschlag_1")
  terminVorschlag2 DateTime? @map("termin_vorschlag_2")

  // CO₂ block
  co2Override              Boolean  @default(false) @map("co2_override")
  co2TonnenProJahr         Decimal? @map("co2_tonnen_pro_jahr") @db.Decimal(10, 2)
  co2HektarMischwald       Decimal? @map("co2_hektar_mischwald") @db.Decimal(10, 2)
  co2FussballfelderProJahr Decimal? @map("co2_fussballfelder_pro_jahr") @db.Decimal(10, 2)

  // Back-relations
  images    StudyImage[]
  documents GeneratedDocument[]

  // Soft-delete / org / timestamps
  deletedAt      DateTime? @map("deleted_at")
  organizationId String    @default("greenscout") @map("organization_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  generatedAt    DateTime? @map("generated_at")

  // Indexes (per DECISIONS contract)
  @@index([consultantId])
  @@index([customerId])
  @@index([status])
  @@index([organizationId, status])
  @@index([organizationId, consultantId, deletedAt])
  @@index([organizationId, createdAt])
}

/// Per-study BEFORE/AFTER photos.
/// Exactly one BEFORE + one AFTER per study enforced via @@unique([studyId, type]).
model StudyImage {
  id String @id @default(cuid())

  studyId String @map("study_id")
  study   Study  @relation(fields: [studyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  type          ImageType
  filename      String
  mimeType      String    @map("mime_type")
  widthPx       Int       @map("width_px")
  heightPx      Int       @map("height_px")
  fileSizeBytes Int       @map("file_size_bytes")
  uploadedAt    DateTime  @default(now()) @map("uploaded_at")

  @@unique([studyId, type])
}

/// Generated PPTX / PDF artefact for a study.
/// onDelete:Cascade on study — DB rows AND physical files under ./generated/studies/<studyId>/
/// are wiped on DSGVO hard-delete (audit trail remains in AuditLog.action = GENERATE_DOCUMENT).
/// generatedById:SetNull — user hard-delete preserves the document; historical actor identity
/// preserved in AuditLog.userId (also SetNull).
model GeneratedDocument {
  id String @id @default(cuid())

  studyId String @map("study_id")
  study   Study  @relation(fields: [studyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  generatedById String? @map("generated_by_id")
  generatedBy   User?   @relation(fields: [generatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  format      DocFormat
  filename    String
  generatedAt DateTime  @default(now()) @map("generated_at")

  @@index([studyId, generatedAt(sort: Desc)])
}

/// Append-only audit trail. No `@updatedAt` — entries are immutable from the application layer.
/// entityType / action are validated against allow-lists in code, not at the DB level, so new
/// event types can be added without schema migrations.
/// changeSet is jsonb (implicit via Prisma Json + Postgres). Application-layer convention is the
/// per-field tuple format { "fieldName": [oldValue, newValue], ... } per DECISIONS.
model AuditLog {
  id String @id @default(cuid())

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  action         String
  changeSet      Json?    @map("change_set")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  organizationId String   @default("greenscout") @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
}

/// Single-row key/value store for app-wide config.
/// Expected keys: smtp.host, smtp.port, smtp.user, smtp.password_enc, smtp.from_name,
/// smtp.from_address, smtp.use_starttls, retention.years, retention.notice_days.
/// SMTP password is AES-256-GCM encrypted via SETTINGS_ENCRYPTION_KEY env (DECISIONS T-004).
/// No organizationId in MVP (single-tenant); Phase-3 will add per the contract.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
}
