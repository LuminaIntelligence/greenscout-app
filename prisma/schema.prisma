// GreenScout — Prisma schema
// Schema source-of-truth: DECISIONS.md → "Slice 2 schema design approved
// (user-confirmed, binding for T-009 through T-013)". Do not add models
// here without updating that entry first.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────

enum Role {
  ADMIN
  BERATER
}

enum StudyStatus {
  DRAFT
  READY
  GENERATED
}

enum ImageType {
  BEFORE
  AFTER
}

enum DocFormat {
  PPTX
  PDF
}

enum FormPref {
  WIZARD
  SINGLE_PAGE
}
